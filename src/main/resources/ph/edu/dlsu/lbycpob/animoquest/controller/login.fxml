<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" styleClass="#majorTitleLabel" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ph.edu.dlsu.lbycpob.animoquest.controller.LoginController">

    <VBox alignment="CENTER" prefWidth="300.0" spacing="10.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="100.0">

        <Label styleClass="majorTitleLabel" text="AnimoQuest Login" />

        <Label text="DLSU ID Number" />

        <TextField fx:id="idNumberField" promptText="Enter valid 8-digit ID number" />

        <Label text="Password" />

        <PasswordField fx:id="passwordField" promptText="Enter password" />

        <Button onAction="#handleLogin" text="Login" />

        <Button onAction="#handleBack" text="Back" />

    </VBox>

</AnchorPane>
