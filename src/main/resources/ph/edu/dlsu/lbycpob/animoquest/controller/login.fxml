<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.animoquest.controller.LoginController"
            prefHeight="400.0"
            prefWidth="600.0">

    <VBox spacing="10.0"
          alignment="CENTER"
          prefWidth="300.0"
          AnchorPane.leftAnchor="150.0"
          AnchorPane.rightAnchor="150.0"
          AnchorPane.topAnchor="50.0">

        <!-- Title -->
        <Label text="AnimoQuest"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <Label text="Login"
               style="-fx-font-size: 18px;" />

        <!-- Username -->
        <Label text="Username" />

        <TextField fx:id="usernameField"
                   promptText="Enter username" />

        <!-- ID Number -->
        <Label text="ID Number" />

        <TextField fx:id="idNumberField"
                   promptText="Enter ID number" />

        <!-- Password -->
        <Label text="Password" />

        <PasswordField fx:id="passwordField"
                       promptText="Enter password" />

        <!-- Login Button -->
        <Button fx:id="loginButton"
                text="Login"
                onAction="#handleLogin"
                prefWidth="150.0" />

    </VBox>

</AnchorPane>