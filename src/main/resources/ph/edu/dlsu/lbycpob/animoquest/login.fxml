<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.animoquest.controller.LoginController"
            prefHeight="400.0"
            prefWidth="600.0">

    <VBox spacing="10.0"
          alignment="CENTER"
          prefWidth="300.0"
          AnchorPane.leftAnchor="150.0"
          AnchorPane.rightAnchor="150.0"
          AnchorPane.topAnchor="50.0">

        <Label text="AnimoQuest" />

        <Label text="ID Number" />

        <TextField fx:id="idNumberField"
                   promptText="Enter ID number" />

        <Label text="Password" />

        <PasswordField fx:id="passwordField"
                       promptText="Enter password" />

        <Button fx:id="loginButton"
                text="Login"
                onAction="#handleLogin" />

    </VBox>

</AnchorPane>