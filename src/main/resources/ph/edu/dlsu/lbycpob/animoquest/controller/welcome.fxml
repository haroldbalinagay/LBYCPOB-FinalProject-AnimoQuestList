<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.animoquest.controller.WelcomeController"
            prefHeight="400.0"
            prefWidth="600.0">

    <VBox spacing="15.0"
          alignment="CENTER"
          prefWidth="300.0"
          AnchorPane.leftAnchor="150.0"
          AnchorPane.rightAnchor="150.0"
          AnchorPane.topAnchor="80.0">

        <Label text="AnimoQuest"
               style="-fx-font-size: 28px; -fx-font-weight: bold;" />

        <Label text="Welcome to AnimoQuest"
               style="-fx-font-size: 16px;" />

        <Button text="Login"
                prefWidth="200.0"
                onAction="#handleLogin" />

        <Button text="Sign Up"
                prefWidth="200.0"
                onAction="#handleSignUp" />

    </VBox>

</AnchorPane>